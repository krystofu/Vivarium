{
  "name": "vivarium-encyclopedia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test test/app.test.mjs test/cloud.test.mjs",
    "check": "node --check server.mjs && node --check cloud/mcp.mjs && node --check cloud/assets.mjs && node --check public/app.js && node --check public/site-tools.js",
    "build": "node build.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260426.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  }
}
