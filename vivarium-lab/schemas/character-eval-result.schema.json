{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivarium.local/schemas/character-eval-result.schema.json",
  "title": "Vivarium Character Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "suite_id",
    "model",
    "evidence_level",
    "trials",
    "summary",
    "certification_state"
  ],
  "properties": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "commit_sha": {"type": ["string", "null"]},
        "artifact_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "suite_id": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider", "model_id"],
      "properties": {
        "provider": {"type": "string"},
        "model_id": {"type": "string"},
        "parameters": {"type": "object"},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "evidence_level": {
      "enum": ["LOCAL", "SIMULATED", "LIVE"]
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trial_id", "scores", "automatic_failures", "evidence"],
        "properties": {
          "trial_id": {"type": "string"},
          "raw_output": {"type": ["string", "null"]},
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "automatic_failures": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "evidence": {"type": "string"},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average_score", "pass", "protected_dimension_failures"],
      "properties": {
        "average_score": {"type": "number", "minimum": 0, "maximum": 3},
        "pass": {"type": "boolean"},
        "protected_dimension_failures": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "regressions": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "certification_state": {
      "enum": ["DRAFT", "LOCAL_PASS", "EVAL_CANDIDATE", "LIVE_CANDIDATE", "LIVE_CERTIFIED", "CANONICAL"]
    },
    "created_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
